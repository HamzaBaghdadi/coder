<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Noise rules that fight readable code rather than improve it. -->
    <NoWarn>$(NoWarn);CA1002;CA1031;CA1305;CA1307;CA1309;CA1310;CA1716;CA1720;CA1724;CA1805;CA1815;CA1819;CA1822;CA1848;CA2007;CA1062;CA1303;CA1515;CA1711;CA1861;CA1708;CA1065;CA1034;CA1508;CA1056;CA1054;CA1859</NoWarn>
    <Authors>Coder</Authors>
    <Product>Coder</Product>
    <Version>0.2.1</Version>
  </PropertyGroup>
</Project>
